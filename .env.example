# Copy to .env and fill in. .env is git-ignored: never commit real values.

# ---------------------------------------------------------------- Server
HOST=127.0.0.1
PORT=8000
# URL your phone/browser uses to reach the server (your Tailscale HTTPS URL once set up).
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Dhaka
OWNER_NAME=
# Language for notifications and email summaries (chat replies follow your own language).
ASSISTANT_LANGUAGE=Bangla
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Database
# PostgreSQL with the pgvector extension. Use 127.0.0.1, not localhost (WSL doesn't forward IPv6).
DATABASE_URL=postgresql://sora:CHANGE_ME@127.0.0.1:5432/sora
# Windows without Docker: the WSL distro running Postgres. Sora keeps it awake while running.
WSL_DISTRO=
# Generated by `python -m sora setup`. Back it up: stored Google tokens can't be read without it.
ENCRYPTION_KEY=

# ---------------------------------------------------------------- LLM (any OpenAI-compatible API)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Any model that supports tool calling: https://openrouter.ai/models?supported_parameters=tools
# (models ending in ":free" cost nothing but are rate-limited and may train on your data).
LLM_MODEL=
# Optional cheaper model for email triage (defaults to LLM_MODEL).
LLM_FAST_MODEL=
LLM_TEMPERATURE=0.4
LLM_STREAM=true
LLM_MAX_TOOL_ROUNDS=8
# OpenRouter only: none | low | medium | high (empty = model default). Reasoning tokens are billed as output.
LLM_REASONING=low
# OpenRouter only: models tried in order if the main one errors or is down, e.g. anthropic/claude-haiku-5.5
LLM_FALLBACK_MODELS=
# OpenRouter only: "deny" routes only to providers that don't store/train on prompts (emails pass through the LLM).
LLM_DATA_COLLECTION=deny
# OpenRouter only: allowed quantizations for open-weight models; skip lossy fp4/int4 hosts, e.g. fp8,fp16,bf16,fp32
LLM_QUANTIZATIONS=

# ---------------------------------------------------------------- Embeddings (RAG)
# Optional: without a key, search falls back to Postgres full-text search.
# Decide EMBEDDING_DIM before the first `setup`: it fixes the vector column size.
# qwen/qwen3-embedding-8b ranked best for Bangla/Banglish/English retrieval in our tests. Empty EMBEDDING_API_KEY reuses LLM_API_KEY.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=1536
EMBEDDING_SEND_DIMENSIONS=true

# ---------------------------------------------------------------- Web search (the web_search tool)
# brave (https://brave.com/search/api) | tavily (https://tavily.com) | duckduckgo (no key needed).
# DuckDuckGo is also used when the keyed provider fails.
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------- Google (see docs/google-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {PUBLIC_BASE_URL}/oauth/google/callback. Must match the OAuth client exactly.
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- Background jobs
EMAIL_WATCHER_ENABLED=true
GMAIL_POLL_SECONDS=90
TRIAGE_SKIP_LABELS=CATEGORY_PROMOTIONS,CATEGORY_SOCIAL,SPAM
REMINDER_POLL_SECONDS=20

# ---------------------------------------------------------------- Push notifications (optional)
# Path to a Firebase service-account JSON (keep it outside the repo or git-ignored).
FCM_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------- Voice (speech-to-text for every app)
# local (Whisper on this PC's NVIDIA GPU: free, private; `pip install -e backend[local-stt]`)
# | groq (free tier) | openai | none (phones fall back to their own recogniser)
STT_PROVIDER=groq
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# Empty = pick Bangla or English per recording; or force bn / en
STT_LANGUAGE=
# large-v3 writes Bangla far better than large-v3-turbo (which hears it as Hindi); turbo is lighter (~1.6 GB vs ~3 GB on the GPU)
WHISPER_LOCAL_MODEL=large-v3
# Where local Whisper models are downloaded (keep off a full C: drive), e.g. D:\models\whisper
WHISPER_MODEL_DIR=
TTS_VOICE_BN=bn-BD-NabanitaNeural
TTS_VOICE_EN=en-US-AvaMultilingualNeural

# ---------------------------------------------------------------- PC agent
SORA_SERVER_URL=http://127.0.0.1:8000
# Created by: python -m sora create-device --name "My PC" --kind pc_agent --save-as PC_AGENT_TOKEN
PC_AGENT_TOKEN=
# "Hey Sora" on the PC: WAKE_WORD=0 makes it off by default (the app's Settings switch it too).
# The on-device model (data/models/wakeword, from scripts/wakeword/train.py) decides when the name was said
# and only then asks the server's Whisper; WAKE_ENGINE=whisper sends every bit of speech to Whisper instead.
# WAKE_THRESHOLD: the model's score that counts as its name (0..1; lower hears it more readily).
WAKE_WORD=1
WAKE_ENGINE=model
WAKE_THRESHOLD=0.5
# File actions (copy, move, zip...) work only in Desktop, Documents, Downloads, Pictures, Music, Videos and these
# folders (separated by ;), e.g. D:\Projects;D:\Thesis
PROJECT_DIRS=
# The phone hears when a download finishes / a training run ends on this PC (0 = off).
DOWNLOAD_WATCH=1
TRAINING_WATCH=1
# The browser Sora drives (and reads watched pages with): the installed Chrome, else Edge. Its own profile is in
# data/browser-profile, so log in to a site there once. BROWSER_EXECUTABLE=path\to\chrome.exe uses another one.
BROWSER_CHANNEL=chrome,msedge
BROWSER_EXECUTABLE=
# VS Code: the PC agent installs the Sora Bridge extension and VS Code windows connect to it (0 = off).
# VSCODE_CLI / CLAUDE_CODE_PATH: the `code` / `claude` commands, if they aren't on PATH.
VSCODE_BRIDGE=1
VSCODE_CLI=
CLAUDE_CODE_PATH=

# "Hey Sora" on this PC shows Sora's orb in the screen's bottom-right corner while you talk (0 = off). It is
# the Windows app's sora.exe (installed, or SORA_APP_EXE=C:\path\to\sora.exe).
CORNER_ORB=1
SORA_APP_EXE=
