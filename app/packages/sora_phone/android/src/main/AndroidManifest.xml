<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stop an app in the background after leaving it ("close YouTube"). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- "Call Ammu": find the number in the phone's contacts and call it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <!-- "Call Ammu from SIM 2": which SIMs there are; texts sent straight from the chosen SIM. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <!-- Clipboard sync: new screenshots go to the PC's clipboard. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- Staying connected to the PC with the app closed (SoraLink). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Find installed apps by name ("open WhatsApp"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <!-- The "Connected to the PC" notification (Android 13+ asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <!-- That notification's Disconnect / Connect / Turn off notification. -->
        <receiver
            android:name="com.yeasir.sora_phone.LinkNotification$Actions"
            android:exported="false"/>
        <!-- The image the PC copied, for the app it is pasted into. -->
        <provider
            android:name="com.yeasir.sora_phone.ClipImageProvider"
            android:authorities="${applicationId}.soraclip"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <!-- Reads the clipboard for a moment after "Copy" (only the app in front may); invisible. -->
        <activity
            android:name="com.yeasir.sora_phone.ClipReaderActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false"/>
        <!-- Chosen apps' notifications to the PC (off until the owner turns it on and allows
             Settings → Notification access → Sora). -->
        <service
            android:name="com.yeasir.sora_phone.SoraNotificationListener"
            android:label="@string/sora_accessibility_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Screenshots and locking the screen without asking each time; the owner turns it on in
             Settings → Accessibility → Sora. -->
        <service
            android:name="com.yeasir.sora_phone.SoraAccessibilityService"
            android:label="@string/sora_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sora_accessibility"/>
        </service>
    </application>
</manifest>
