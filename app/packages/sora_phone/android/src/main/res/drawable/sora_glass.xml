<?xml version="1.0" encoding="utf-8"?>
<!-- The notification's glass panel: a mostly clear tint that lets the shade show through, lit
     from the top-left, with a thin bright rim like crystal. Android draws the card behind it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:angle="315"
                android:startColor="#2EFFFFFF"
                android:centerColor="#0FFFFFFF"
                android:endColor="#1A5CC8FF"
                android:type="linear"/>
            <stroke android:width="1dp" android:color="#47FFFFFF"/>
        </shape>
    </item>
    <!-- the shine along the top edge -->
    <item android:bottom="40dp" android:left="14dp" android:right="14dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>
